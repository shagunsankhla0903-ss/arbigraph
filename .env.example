# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already listed in .gitignore.

# The API key(s) clients must send in the X-API-Key header to call /v1/cycles.
# Pick any private string for local development.
VALID_API_KEYS=my-real-secret-key-2026

# Required: get a free key at https://exchangerate-api.com
# Used as a fallback data source if Frankfurter fails.
EXCHANGERATE_API_KEY=916cef6c95e11252dfe3a7a1